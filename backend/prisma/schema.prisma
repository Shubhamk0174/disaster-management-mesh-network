generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model NodeLocation {
  id        Int      @id @default(autoincrement())
  node_id   String
  timestamp DateTime
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}

model RescueRequest {
  id              Int      @id @default(autoincrement())
  receivedAt      DateTime
  originNode      String
  location        String
  deviceTimestamp String
  rssi            Int?
  originRoot      String
  finalRoot       String
  hopCount        Int?
  encryption      String
  auth            String
  status          String   @default("unresolved")
  notes           String   @default("")
  createdAt       DateTime @default(now())
}
