{
  "expo": {
    "name": "Rescue Mesh",
    "slug": "rescue-mesh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rescuemesh",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rescuemesh.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rescue Mesh requires location access to transmit emergency GPS coordinates to rescue teams over LoRa mesh.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Rescue Mesh requires location access to transmit emergency GPS coordinates to rescue teams over LoRa mesh.",
        "NSLocalNetworkUsageDescription": "Rescue Mesh connects directly to local Wi-Fi rescue nodes without internet.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.rescuemesh.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_NETWORK_STATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121212",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withWifiReborn"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
